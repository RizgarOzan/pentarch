# Copy to .env next to compose.yaml. Every line is optional.
TZ=Europe/Istanbul          # your timezone; the default is UTC
PENTARCH_AGENT_CLI=claude   # claude | gemini | codex | opencode | none
PENTARCH_VOICE=true         # false skips voice packages (smaller image)
# PENTARCH_DATA=./pentarch-data
# PENTARCH_NOTES=./notes
