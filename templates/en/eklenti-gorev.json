{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["-I", "{{APP}}/salt_okunur.py"],
            "timeout": 20
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
